# Salin file ini menjadi .env. Secret key dan base URL dibaca dari apikey.txt.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_ai

# Konfigurasi opsional
# Jika apikey.txt tidak berada di folder proyek, isi path file penggantinya.
# AI_KEY_FILE=./apikey.txt
# ID model harus tersedia pada endpoint /v1/models milik penyedia API.
AI_MODEL=deepseek-v4.1-flash
SYSTEM_PROMPT=Anda adalah asisten WhatsApp yang ramah dan membantu. Jawab dengan ringkas dalam Bahasa Indonesia.
HISTORY_LIMIT=10
AI_TIMEOUT_MS=30000
SESSION_PATH=./auth_info_baileys
LOG_LEVEL=info
WHATSAPP_CONNECT_TIMEOUT_MS=30000
WHATSAPP_MAX_RECONNECT_ATTEMPTS=5
# Kosongkan untuk mengambil client_revision langsung dari WhatsApp Web.
# Isi tiga angka dipisahkan koma hanya sebagai override sementara saat diperlukan.
WHATSAPP_WEB_VERSION=

# Pemilik dan izin AI Agent
# Gunakan nomor WhatsApp dengan kode negara tanpa tanda +. Pisahkan dengan koma.
OWNER_NUMBERS=6281234567890
# Semua akses file dibatasi ke folder berikut. Path relatif dihitung dari folder project.
AGENT_ALLOWED_PATHS=./agent-workspace
# Daftar aplikasi untuk mode biasa. /godmode dapat membuka aplikasi lain.
# Pilihan bawaan: notepad,calculator (Windows), textedit,calculator (macOS), texteditor,calculator (Linux)
AGENT_ALLOWED_APPS=notepad,calculator
# Perintah CMD yang boleh diajukan agent. Isi none untuk menonaktifkannya.
AGENT_ALLOWED_CMD_COMMANDS=ver,whoami,hostname,ipconfig,tasklist,systeminfo
# Kosongkan untuk kamera video pertama yang terdeteksi oleh FFmpeg.
CAMERA_DEVICE_NAME=
CAMERA_FFMPEG_PATH=ffmpeg
# OCR digunakan untuk posisi teks pada screenshot dan cadangan bila input visual gagal.
OCR_LANGUAGES=eng,ind
# Browser agent membuka jendela Edge tersendiri; gunakan chrome jika Edge tidak tersedia.
BROWSER_CHANNEL=msedge
BROWSER_HEADLESS=false
# Profil khusus browser agent. Pertahankan folder ini agar cookie dan sesi browser tidak berpindah saat restart.
BROWSER_USER_DATA_DIR=./agent-workspace/browser-profile
# Server MCP jaringan yang diizinkan. Isi JSON satu baris, contoh:
# MCP_SERVERS_JSON=[{"name":"server_saya","url":"https://example.com/mcp","headers":{"Authorization":"Bearer token-mcp"}}]
MCP_SERVERS_JSON=
AGENT_APPROVAL_TTL_MINUTES=10
# Lama /godmode aktif dalam satu chat pribadi. Reset saat bot restart.
AGENT_GODMODE_TTL_MINUTES=30
AGENT_MAX_FILE_BYTES=32768
AGENT_MAX_MEDIA_BYTES=10485760
